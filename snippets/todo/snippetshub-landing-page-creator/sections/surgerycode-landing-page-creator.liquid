<section class="surgerycode-lp">
  {% for block in section.blocks %}
    {% case block.type %}
      {% when 'hero' %}
        <div class="surgerycode-lp__hero" style="background-image:url({{ block.settings.bg_image | image_url }})">
          <div class="surgerycode-lp__hero-inner">
            <h1>{{ block.settings.heading }}</h1>
            <p>{{ block.settings.subheading }}</p>
            {% if block.settings.cta_label != blank %}
              <a class="surgerycode-lp__btn" href="{{ block.settings.cta_url }}">{{ block.settings.cta_label }}</a>
            {% endif %}
          </div>
        </div>
      {% when 'text' %}
        <div class="surgerycode-lp__text section-padding">
          <div class="container">{{ block.settings.richtext }}</div>
        </div>
      {% when 'image' %}
        <div class="surgerycode-lp__image section-padding">
          <div class="container"><img src="{{ block.settings.image | image_url }}" alt="{{ block.settings.alt }}"></div>
        </div>
      {% when 'cta' %}
        <div class="surgerycode-lp__cta section-padding">
          <div class="container">
            <h2>{{ block.settings.heading }}</h2>
            <a class="surgerycode-lp__btn" href="{{ block.settings.url }}">{{ block.settings.label }}</a>
          </div>
        </div>
      {% when 'faq' %}
        <div class="surgerycode-lp__faq section-padding">
          <div class="container">
            <details class="surgerycode-lp__faq-item"><summary>{{ block.settings.q1 }}</summary><div class="answer">{{ block.settings.a1 }}</div></details>
            <details class="surgerycode-lp__faq-item"><summary>{{ block.settings.q2 }}</summary><div class="answer">{{ block.settings.a2 }}</div></details>
          </div>
        </div>
    {% endcase %}
  {% endfor %}
</section>
<link rel="stylesheet" href="{{ 'surgerycode-landing-page-creator.css' | asset_url }}">
<script src="{{ 'surgerycode-landing-page-creator.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "SurgeryCode Landing Page Creator",
  "blocks": [
    {"type":"hero","name":"Hero","settings":[
      {"type":"image_picker","id":"bg_image","label":"Background image"},
      {"type":"text","id":"heading","label":"Heading","default":"Your big headline"},
      {"type":"text","id":"subheading","label":"Subheading","default":"A supporting subheading"},
      {"type":"text","id":"cta_label","label":"CTA label","default":"Shop now"},
      {"type":"url","id":"cta_url","label":"CTA URL"}
    ]},
    {"type":"text","name":"Text","settings":[
      {"type":"richtext","id":"richtext","label":"Content","default":"<p>Your content here</p>"}
    ]},
    {"type":"image","name":"Image","settings":[
      {"type":"image_picker","id":"image","label":"Image"},
      {"type":"text","id":"alt","label":"Alt text","default":"Image"}
    ]},
    {"type":"cta","name":"Call to Action","settings":[
      {"type":"text","id":"heading","label":"Heading","default":"Don\u2019t miss out"},
      {"type":"text","id":"label","label":"Button label","default":"Buy now"},
      {"type":"url","id":"url","label":"Button URL"}
    ]},
    {"type":"faq","name":"FAQ","settings":[
      {"type":"text","id":"q1","label":"Question 1","default":"What is this?"},
      {"type":"text","id":"a1","label":"Answer 1","default":"An awesome product."},
      {"type":"text","id":"q2","label":"Question 2","default":"How fast is shipping?"},
      {"type":"text","id":"a2","label":"Answer 2","default":"Usually 2-5 business days."}
    ]}
  ],
  "presets": [ { "name": "Landing Page", "category": "Pages" } ]
}
{% endschema %}
