    {
      "type": "url",
      "id": "btn_primary_url",
      "label": "URL"
    },
    {
      "type": "header",
      "content": "Secondary Button"
    },
    {
      "type": "text",
      "id": "btn_secondary_label",
      "label": "Label",
      "default": "View Menu"
