        {
          "type": "text",
          "id": "description",
          "label": "Short description",
          "default": "Pan-seared with lemon butter and herbs"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Food Hunt",
      "category": "Hero",
      "blocks": [
        {
          "type": "dish",
          "settings": {
            "name": "Grilled Salmon",
            "description": "Pan-seared with lemon butter and fresh herbs"
          }
        },
        {
          "type": "dish",
          "settings": {
            "name": "Caesar Salad",
            "description": "Crispy romaine with house-made dressing"
          }
        },
        {
          "type": "dish",
          "settings": {
            "name": "Beef Tenderloin",
            "description": "Medium-rare with truffle jus"
          }
        },
        {
          "type": "dish",
          "settings": {
            "name": "Mushroom Risotto",
            "description": "Creamy arborio with porcini"
          }
        }
      ]
    }
  ]
}
{% endschema %}
