
<main class="surgerycode-app">
    <h1 class="surgerycode-title">Surgerycode — Counter (DOM)</h1>

    <!-- Przykładowy licznik: odliczanie do daty -->
    <section class="surgerycode-counter" data-type="until" data-target="2025-12-31T23:59:59">
      <div class="surgerycode-counter__label">Do końca roku</div>
      <div class="surgerycode-counter__wrap" aria-live="polite"></div>
      <div class="surgerycode-counter__controls">
        <button class="surgerycode-btn" data-action="toggle-order">Odwróć kolejność</button>
      </div>
    </section>

    <!-- Przykładowy licznik: liczenie od daty -->
    <section class="surgerycode-counter" data-type="since" data-target="2020-01-01T00:00:00" data-order="smh">
      <div class="surgerycode-counter__label">Od 2020-01-01</div>
      <div class="surgerycode-counter__wrap" aria-live="polite"></div>
    </section>
</main>
<script
  src="{{ 'surgerycode-counter.js' | asset_url }}"
  type="module"
  fetchpriority="low">
</script>

{{ 'surgerycode-counter.css' | asset_url | stylesheet_tag }}

{% stylesheet %}

{% endstylesheet %}

