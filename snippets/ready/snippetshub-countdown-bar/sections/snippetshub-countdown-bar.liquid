      }
      #snippetshub-countdown-bar-{{ section.id }}.snippetshub-countdown-bar--fathers_day .snippetshub-countdown-bar__close {
        color: #03a3cb;
      }

      #snippetshub-countdown-bar-{{ section.id }}.snippetshub-countdown-bar--easter .snippetshub-countdown-bar__inner {
        background: linear-gradient(90deg,#fff7e6,#b6f0d6);
        background-image: url({{ 'snippetshub-countdown-bar-easter.png' | asset_url }});
        background-size: cover;
        color: #2b3a2b;
      }
      #snippetshub-countdown-bar-{{ section.id }}.snippetshub-countdown-bar--easter .snippetshub-countdown-bar__text {
        font-size: 16px;
        font-weight: 500;
        color: #f4843a;
      }
      #snippetshub-countdown-bar-{{ section.id }}.snippetshub-countdown-bar--easter .snippetshub-countdown-bar__button--primary {
        {% comment %} background-color: #0573a8; {% endcomment %}
        background-color: rgba(0, 0, 0, 0);
        color: #f4843a;
      }
      #snippetshub-countdown-bar-{{ section.id }}.snippetshub-countdown-bar--easter .snippetshub-countdown-bar__button--secondary {
        background-color: #fe6579;
        color: #e6f0ff;
      }
      #snippetshub-countdown-bar-{{ section.id }}.snippetshub-countdown-bar--easter .snippetshub-countdown-bar__timer {
        color: #f4843a;
      }
      #snippetshub-countdown-bar-{{ section.id }}.snippetshub-countdown-bar--easter .snippetshub-countdown-bar__close {
        color: #f4843a;
      }

      #snippetshub-countdown-bar-{{ section.id }}.snippetshub-countdown-bar--childrens_day .snippetshub-countdown-bar__inner {
        background: linear-gradient(90deg,#ffd6a5,#ffb3c6);
        background-image: url({{ 'snippetshub-countdown-bar-childrens_day.png' | asset_url }});
        background-size: cover;
        color: #2b1a1a;
      }
      #snippetshub-countdown-bar-{{ section.id }}.snippetshub-countdown-bar--childrens_day .snippetshub-countdown-bar__text {
        font-size: 16px;
        font-weight: 500;
