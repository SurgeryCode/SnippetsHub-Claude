    <script>
    document.addEventListener("DOMContentLoaded", function () {
      const id = "{{ section.id }}";
      const bar = document.getElementById(`snippetshub-countdown-bar-${id}`);
      if (!bar) return;
      const closeBtn = bar.querySelector(".snippetshub-countdown-bar__close");
      const timer = bar.querySelector(".snippetshub-countdown-bar__timer");
      const hasTimer = !!(timer && timer.dataset);
      const startDateRaw = hasTimer ? timer.dataset.startDate : null;
      const endDateRaw = hasTimer ? timer.dataset.endDate : null;
      const endMessage = hasTimer && timer.dataset.endMessage ? timer.dataset.endMessage : "Event started!";
      const hideAfterEnd = {{ section.settings.hide_after_end | default: false }};
      const startDate = startDateRaw ? new Date(startDateRaw) : null;
      const endDate = endDateRaw ? new Date(endDateRaw) : null;
      const reappearDays = {{ section.settings.reappear_days }};
      const hideKey = `snippetshub_countdown_hidden_until_${id}`;

      try {
        const hiddenUntil = localStorage.getItem(hideKey);
        if (hiddenUntil && new Date(hiddenUntil) > new Date()) return;
      } catch (err) {
        // localStorage may be blocked; ignore
      }

      const now = new Date();
      if (startDate && !isNaN(startDate) && now < startDate) return;

      if (endDate && !isNaN(endDate) && now > endDate && hideAfterEnd) {
        bar.style.display = "none";
        return;
      }

      bar.style.display = "block";
      bar.style.opacity = "0";
      bar.style.transform = "translateY(-20px)";
      setTimeout(() => {
        bar.style.opacity = "1";
        bar.style.transform = "translateY(0)";
      }, 50);

      function updateCountdown() {
        if (!hasTimer || !endDate || isNaN(endDate)) return;
        const now = new Date();
        const diff = endDate - now;
        if (diff <= 0) {
          if (timer) timer.textContent = endMessage;
          if (interval) clearInterval(interval);
          if (hideAfterEnd) {
            setTimeout(() => { bar.style.display = "none"; }, 300);
          }
          return;
        }
        const days = Math.floor(diff / (1000 * 60 * 60 * 24));
        const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
        const minutes = Math.floor((diff / (1000 * 60)) % 60);
        const seconds = Math.floor((diff / 1000) % 60);
        if (timer) {
          timer.querySelector("[data-days]").textContent = String(days).padStart(2, "0");
          timer.querySelector("[data-hours]").textContent = String(hours).padStart(2, "0");
          timer.querySelector("[data-minutes]").textContent = String(minutes).padStart(2, "0");
          timer.querySelector("[data-seconds]").textContent = String(seconds).padStart(2, "0");
        }
      }

      let interval = null;
      if (hasTimer && endDate && !isNaN(endDate)) {
        interval = setInterval(updateCountdown, 1000);
        updateCountdown();
      }

      if (closeBtn) closeBtn.addEventListener("click", () => {
        bar.style.opacity = "0";
        bar.style.transform = "translateY(-100%)";
        setTimeout(() => { bar.style.display = "none"; }, 300);
        const reappearDate = new Date();
        reappearDate.setDate(reappearDate.getDate() + reappearDays);
        try {
          localStorage.setItem(hideKey, reappearDate.toISOString());
        } catch (err) {
          // localStorage may be blocked; ignore
        }
      });
    });
    </script>
  </div>
{% endif %}

