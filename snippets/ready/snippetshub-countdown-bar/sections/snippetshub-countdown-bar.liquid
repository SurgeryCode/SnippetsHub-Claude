{%- comment -%}
SnippetsHub
Section: SnippetsHub Countdown Bar
Version: 1.0.0
License: Default is Single Store License unless the purchased product variant states otherwise.
Support: support@snippetshub.com
{%- endcomment -%}

{% assign selected_font = section.settings.font_family %}
{% assign show_on = section.settings.show_on | default: 'all' %}
{% assign page_type = request.page_type %}
{% assign render_bar = false %}
{% if show_on == 'all' %}
  {% assign render_bar = true %}
{% elsif show_on == 'home' and page_type == 'index' %}
  {% assign render_bar = true %}
{% elsif show_on == 'product' and page_type == 'product' %}
  {% assign render_bar = true %}
{% elsif show_on == 'collection' and page_type == 'collection' %}
  {% assign render_bar = true %}
{% endif %}
{% if render_bar %}
  <div
    class="SnippetsHub SNH-countdown-bar snippetshub-countdown-bar snippetshub-countdown-bar--{{ section.settings.theme_style }}"
    id="snippetshub-countdown-bar-{{ section.id }}"
    data-snh="snippetshub-countdown-bar"
    data-snh-version="1.0.0"
    data-snh-owner="SnippetsHub"
    style="display:none;"
  >
    <div class="snippetshub-countdown-bar__inner">
      <div class="snippetshub-countdown-bar__content">
        {% if section.settings.scroll_text %}
          <div
            class="snippetshub-countdown-bar__text snippetshub-countdown-bar__text--scroll{% if section.settings.marquee_pause_on_hover %} snippetshub-countdown-bar__text--pause-on-hover{% endif %}{% if section.settings.marquee_direction == 'right' %} snippetshub-countdown-bar__text--dir-right{% endif %}{% if section.settings.marquee_mobile_only %} snippetshub-countdown-bar__text--mobile-only{% endif %}"
            style="--sc-marquee-duration: {{ section.settings.marquee_duration | default: '20s' }}; --sc-marquee-gap: {{ section.settings.marquee_gap | default: '2rem' }};"
            {% if section.settings.marquee_aria_label != blank %}
              aria-label="{{ section.settings.marquee_aria_label }}" aria-live="off"
            {% endif %}
          >
            <div class="snippetshub-countdown-bar__text-track">
              <span class="snippetshub-countdown-bar__text-segment">{{ section.settings.text }}</span>
              <span class="snippetshub-countdown-bar__text-segment" aria-hidden="true">
                {{- section.settings.text -}}
              </span>
            </div>
          </div>
        {% else %}
          <div class="snippetshub-countdown-bar__text">
            {{ section.settings.text }}
          </div>
        {% endif %}

        {% if section.settings.cta_1_link != blank and section.settings.cta_1_label != blank %}
          <a
            href="{{ section.settings.cta_1_link }}"
            class="snippetshub-countdown-bar__button snippetshub-countdown-bar__button--primary"
          >
            {{ section.settings.cta_1_label }}
          </a>
        {% elsif section.settings.cta_1_label != blank %}
          <span
            class="snippetshub-countdown-bar__button snippetshub-countdown-bar__button--primary snippetshub-countdown-bar__button--disabled"
            aria-disabled="true"
          >
            {{ section.settings.cta_1_label }}
          </span>
        {% endif %}

        {% if section.settings.cta_2_link != blank and section.settings.cta_2_label != blank %}
          <a
            href="{{ section.settings.cta_2_link }}"
            class="snippetshub-countdown-bar__button snippetshub-countdown-bar__button--secondary"
          >
            {{ section.settings.cta_2_label }}
          </a>
        {% elsif section.settings.cta_2_label != blank %}
          <span
            class="snippetshub-countdown-bar__button snippetshub-countdown-bar__button--secondary snippetshub-countdown-bar__button--disabled"
            aria-disabled="true"
          >
            {{ section.settings.cta_2_label }}
          </span>
        {% endif %}

        {% if section.settings.show_timer %}
          <div
            class="snippetshub-countdown-bar__timer"
            data-start-date="{{ section.settings.start_date }}"
            data-end-date="{{ section.settings.event_date }}"
            data-end-message="{{ section.settings.end_message | escape }}"
          >
            <div class="snippetshub-countdown-bar__time-item">
              <span class="snippetshub-countdown-bar__time-value" data-days>00</span>
              <span class="snippetshub-countdown-bar__time-label">{{ section.settings.label_days }}</span>
            </div>
            <div class="snippetshub-countdown-bar__time-item">
              <span class="snippetshub-countdown-bar__time-value" data-hours>00</span>
              <span class="snippetshub-countdown-bar__time-label">{{ section.settings.label_hours }}</span>
            </div>
            <div class="snippetshub-countdown-bar__time-item">
              <span class="snippetshub-countdown-bar__time-value" data-minutes>00</span>
              <span class="snippetshub-countdown-bar__time-label">{{ section.settings.label_minutes }}</span>
            </div>
            <div class="snippetshub-countdown-bar__time-item">
              <span class="snippetshub-countdown-bar__time-value" data-seconds>00</span>
              <span class="snippetshub-countdown-bar__time-label">{{ section.settings.label_seconds }}</span>
            </div>
          </div>
        {% endif %}

        <button class="snippetshub-countdown-bar__close" type="button" aria-label="Close">&times;</button>
      </div>
    </div>

    <style>
      #snippetshub-countdown-bar-{{ section.id }} {
        width: 100%;
        position: relative;
      z-index: {{ section.settings.z_index }};
        transition: opacity 0.3s ease, transform 0.3s ease;
        margin-top: {{ section.settings.margin_top }};
        margin-bottom: {{ section.settings.margin_bottom }};
        font-family: {{ selected_font.family }}, {{ selected_font.fallback_families }};
        --snh-text-color: {{ section.settings.text_color }};
        --snh-cta1-bg: {{ section.settings.cta_1_bg }};
        --snh-cta1-color: {{ section.settings.cta_1_color }};
        --snh-cta2-bg: {{ section.settings.cta_2_bg }};
        --snh-cta2-color: {{ section.settings.cta_2_color }};
        --snh-timer-color: {{ section.settings.text_color }};
        --snh-time-item-bg: {{ section.settings.time_item_bg_gradient | default: section.settings.time_item_bg_color | default: 'transparent' }};
        --snh-close-color: {{ section.settings.close_color }};
      }

      #snippetshub-countdown-bar-{{ section.id }} .snippetshub-countdown-bar__inner {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        background: {{ section.settings.background_gradient | default: section.settings.background_color }};
        {% if section.settings.background_image_desktop != blank %}
          background-image: url({{ section.settings.background_image_desktop | image_url: width: 2000 }});
        {% elsif section.settings.background_image_mobile != blank %}
          background-image: url({{ section.settings.background_image_mobile | image_url: width: 800 }});
        {% endif %}
        background-size: cover;
        background-repeat: no-repeat;
        background-position: center;
      }

      @media (max-width: 768px) {
        #snippetshub-countdown-bar-{{ section.id }} .snippetshub-countdown-bar__inner {
          {% if section.settings.background_image_mobile != blank %}
            background-image: url({{ section.settings.background_image_mobile | image_url: width: 800 }});
          {% elsif section.settings.background_image_desktop != blank %}
            background-image: url({{ section.settings.background_image_desktop | image_url: width: 2000 }});
          {% endif %}
        }
      }

      #snippetshub-countdown-bar-{{ section.id }} .snippetshub-countdown-bar__content {
        display: grid;
        grid-template-columns: repeat(4, auto);
        align-items: center;
        gap: 1rem;
        width: {{ section.settings.inner_width }};
        max-width: 100%;
        padding: {{ section.settings.content_padding }};
        text-align: center;
        background: {{ section.settings.inner_background_gradient | default: section.settings.inner_background_color }};
        {% if section.settings.inner_background_image != blank %}
          background-image: url({{ section.settings.inner_background_image | image_url }});
          background-size: cover;
          background-repeat: no-repeat;
          background-position: center;
        {% endif %}
        border-radius: {{ section.settings.content_border_radius }};
        box-sizing: border-box;
        position: relative;
      }

      #snippetshub-countdown-bar-{{ section.id }} .snippetshub-countdown-bar__text {
        font-size: {{ section.settings.text_font_size }};
        font-weight: 500;
        color: var(--snh-text-color);
      }

      #snippetshub-countdown-bar-{{ section.id }} .snippetshub-countdown-bar__text--scroll {
        overflow: hidden;
      }
      #snippetshub-countdown-bar-{{ section.id }} .snippetshub-countdown-bar__text--scroll .snippetshub-countdown-bar__text-track {
        display: inline-flex;
        align-items: center;
        gap: var(--sc-marquee-gap, 2rem);
        white-space: nowrap;
        will-change: transform;
        animation: sc-marquee-{{ section.id }} var(--sc-marquee-duration, 20s) linear infinite;
      }
      #snippetshub-countdown-bar-{{ section.id }} .snippetshub-countdown-bar__text--scroll .snippetshub-countdown-bar__text-segment {
        flex: 0 0 auto;
      }
      #snippetshub-countdown-bar-{{ section.id }} .snippetshub-countdown-bar__text--pause-on-hover:hover .snippetshub-countdown-bar__text-track {
        animation-play-state: paused;
      }
      #snippetshub-countdown-bar-{{ section.id }} .snippetshub-countdown-bar__text--dir-right .snippetshub-countdown-bar__text-track {
        animation-direction: reverse;
      }
      @keyframes sc-marquee-{{ section.id }} {
        from { transform: translateX(0); }
        to { transform: translateX(-50%); }
      }

      @media (min-width: 769px) {
        #snippetshub-countdown-bar-{{ section.id }} .snippetshub-countdown-bar__text--mobile-only {
          overflow: visible;
        }
        #snippetshub-countdown-bar-{{ section.id }} .snippetshub-countdown-bar__text--mobile-only .snippetshub-countdown-bar__text-track {
          animation: none !important;
          white-space: normal;
          display: inline;
          gap: 0;
        }
        #snippetshub-countdown-bar-{{ section.id }} .snippetshub-countdown-bar__text--mobile-only .snippetshub-countdown-bar__text-segment:nth-child(2) {
          display: none;
        }
      }

      #snippetshub-countdown-bar-{{ section.id }} .snippetshub-countdown-bar__button,
      #snippetshub-countdown-bar-{{ section.id }} .snippetshub-countdown-bar__button-text {
        display: inline-block;
        padding: 0.5rem 1rem;
        font-weight: 600;
        border-radius: {{ section.settings.button_border_radius }};
        text-decoration: none;
        transition: background 0.3s ease, color 0.3s ease;
        min-width: 100px;
        text-align: center;
        font-size: {{ section.settings.cta_font_size }};
      }

      #snippetshub-countdown-bar-{{ section.id }} .snippetshub-countdown-bar__button--primary {
        background-color: var(--snh-cta1-bg);
        color: var(--snh-cta1-color);
      }
      #snippetshub-countdown-bar-{{ section.id }} .snippetshub-countdown-bar__button--secondary {
        background-color: var(--snh-cta2-bg);
        color: var(--snh-cta2-color);
      }

      #snippetshub-countdown-bar-{{ section.id }} a.snippetshub-countdown-bar__button:hover {
        opacity: 0.85;
      }

      #snippetshub-countdown-bar-{{ section.id }} .snippetshub-countdown-bar__button-text {
        color: {{ section.settings.text_color }};
        background: transparent;
        cursor: default;
      }

      #snippetshub-countdown-bar-{{ section.id }} .snippetshub-countdown-bar__timer {
        display: flex;
        gap: 0.5rem;
        justify-content: center;
        align-items: center;
        font-size: {{ section.settings.timer_font_size }};
        color: var(--snh-timer-color);
      }

      #snippetshub-countdown-bar-{{ section.id }} .snippetshub-countdown-bar__time-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 0.3rem 0.6rem;
        border-radius: 4px;
        background: var(--snh-time-item-bg);
      }

      #snippetshub-countdown-bar-{{ section.id }} .snippetshub-countdown-bar__time-value {
        font-weight: bold;
        display: block;
      }

      #snippetshub-countdown-bar-{{ section.id }} .snippetshub-countdown-bar__time-label {
        font-size: 0.7em;
        opacity: 0.8;
      }

      #snippetshub-countdown-bar-{{ section.id }} .snippetshub-countdown-bar__close {
        position: absolute;
        right: .3rem;
        top: .3rem;
        background: transparent;
        border: none;
        font-size: 1.5rem;
        line-height: 1;
        color: var(--snh-close-color);
        cursor: pointer;
        transition: opacity 0.3s ease;
      }

      #snippetshub-countdown-bar-{{ section.id }} .snippetshub-countdown-bar__close:hover {
        opacity: 0.7;
      }

      @media (max-width: 768px) {
        #snippetshub-countdown-bar-{{ section.id }} .snippetshub-countdown-bar__content {
          grid-template-columns: 1fr;
          gap: 0.5rem;
        }
        #snippetshub-countdown-bar-{{ section.id }} .snippetshub-countdown-bar__timer {
          flex-wrap: wrap;
        }
      }

      #snippetshub-countdown-bar-{{ section.id }}.snippetshub-countdown-bar--new_year .snippetshub-countdown-bar__inner {
        background: linear-gradient(90deg,#021024,#0b3a66);
        background-image: url({{ 'snippetshub-countdown-bar--new_year.png' | asset_url }});
        background-size: cover;
        color: #ffffff;
      }
      #snippetshub-countdown-bar-{{ section.id }}.snippetshub-countdown-bar--new_year .snippetshub-countdown-bar__text {
        font-size: 16px;
        font-weight: 500;
        color: #ffffff;
      }
      #snippetshub-countdown-bar-{{ section.id }}.snippetshub-countdown-bar--new_year .snippetshub-countdown-bar__button--primary {
        background-color: #1e589b;
        color: #ffffff;
      }
      #snippetshub-countdown-bar-{{ section.id }}.snippetshub-countdown-bar--new_year .snippetshub-countdown-bar__button--secondary {
        background-color: rgba(0, 0, 0, 0);
        color: #ffffff;
      }
      #snippetshub-countdown-bar-{{ section.id }}.snippetshub-countdown-bar--new_year .snippetshub-countdown-bar__timer {
        color: #ffffff;
      }
      #snippetshub-countdown-bar-{{ section.id }}.snippetshub-countdown-bar--new_year .snippetshub-countdown-bar__close {
        color: #ffffff;
      }

      #snippetshub-countdown-bar-{{ section.id }}.snippetshub-countdown-bar--halloween .snippetshub-countdown-bar__inner {
        background: linear-gradient(90deg,#000000,#ff6a00);
        background-image: url({{ 'snippetshub-countdown-bar--halloween.png' | asset_url }});
        background-size: cover;
        color: #ffffff;
      }
      #snippetshub-countdown-bar-{{ section.id }}.snippetshub-countdown-bar--halloween .snippetshub-countdown-bar__text {
        font-size: 16px;
        font-weight: 500;
        color: #ffffff;
      }
      #snippetshub-countdown-bar-{{ section.id }}.snippetshub-countdown-bar--halloween .snippetshub-countdown-bar__button--primary {
        background-color: #38156b;
        color: #ffffff;
      }
      #snippetshub-countdown-bar-{{ section.id }}.snippetshub-countdown-bar--halloween .snippetshub-countdown-bar__button--secondary {
        background-color: rgba(0, 0, 0, 0);
        color: #f3b06d;
      }
      #snippetshub-countdown-bar-{{ section.id }}.snippetshub-countdown-bar--halloween .snippetshub-countdown-bar__timer {
      }
      #snippetshub-countdown-bar-{{ section.id }}.snippetshub-countdown-bar--halloween .snippetshub-countdown-bar__close {
        color: #f3b06d;
      }

      #snippetshub-countdown-bar-{{ section.id }}.snippetshub-countdown-bar--valentines .snippetshub-countdown-bar__inner {
        background: linear-gradient(90deg,#ffdde1,#f7797d);
        background-image: url({{ 'snippetshub-countdown-bar--valentines.png' | asset_url }});
        background-size: cover;
        color: #ffffff;
      }
      #snippetshub-countdown-bar-{{ section.id }}.snippetshub-countdown-bar--valentines .snippetshub-countdown-bar__text {
        font-size: 16px;
        font-weight: 500;
        color: #6e2b61;
      }
      #snippetshub-countdown-bar-{{ section.id }}.snippetshub-countdown-bar--valentines .snippetshub-countdown-bar__button--primary {
        background-color: #6e2b61;
        color: #ffffff;
      }
      #snippetshub-countdown-bar-{{ section.id }}.snippetshub-countdown-bar--valentines .snippetshub-countdown-bar__button--secondary {
        background-color: rgba(0, 0, 0, 0);
        color: #6e2b61;
      }
      #snippetshub-countdown-bar-{{ section.id }}.snippetshub-countdown-bar--valentines .snippetshub-countdown-bar__timer {
        color: #6e2b61;
      }
      #snippetshub-countdown-bar-{{ section.id }}.snippetshub-countdown-bar--valentines .snippetshub-countdown-bar__close {
        color: #6e2b61;
      }

      #snippetshub-countdown-bar-{{ section.id }}.snippetshub-countdown-bar--womens_day .snippetshub-countdown-bar__inner {
        background: linear-gradient(90deg,#f5e6ff,#b388ff);
        background-image: url({{ 'snippetshub-countdown-bar-womens_day.png' | asset_url }});
        background-size: cover;
        color: #ffffff;
      }
      #snippetshub-countdown-bar-{{ section.id }}.snippetshub-countdown-bar--womens_day .snippetshub-countdown-bar__text {
        font-size: 16px;
        font-weight: 500;
        color: #ffffff;
      }
      #snippetshub-countdown-bar-{{ section.id }}.snippetshub-countdown-bar--womens_day .snippetshub-countdown-bar__button--primary {
        background-color: rgba(0, 0, 0, 0);
        color: #ffffff;
      }
      #snippetshub-countdown-bar-{{ section.id }}.snippetshub-countdown-bar--womens_day .snippetshub-countdown-bar__button--secondary {
        background-color: #f00281;
        color: #ffffff;
      }
      #snippetshub-countdown-bar-{{ section.id }}.snippetshub-countdown-bar--womens_day .snippetshub-countdown-bar__timer {
        color: #ffffff;
      }
      #snippetshub-countdown-bar-{{ section.id }}.snippetshub-countdown-bar--womens_day .snippetshub-countdown-bar__close {
        color: #5d48b6;
      }

      #snippetshub-countdown-bar-{{ section.id }}.snippetshub-countdown-bar--mothers_day .snippetshub-countdown-bar__inner {
        background: linear-gradient(90deg,#fff0f6,#ffd6e7);
        background-image: url({{ 'snippetshub-countdown-bar-mothers_day.png' | asset_url }});
        background-size: cover;
        color: #ffffff;
      }
      #snippetshub-countdown-bar-{{ section.id }}.snippetshub-countdown-bar--mothers_day .snippetshub-countdown-bar__text {
        font-size: 16px;
        font-weight: 500;
        color: #ffffff;
      }
      #snippetshub-countdown-bar-{{ section.id }}.snippetshub-countdown-bar--mothers_day .snippetshub-countdown-bar__button--primary {
        background-color: rgba(0, 0, 0, 0);
        color: #ffffff;
      }
      #snippetshub-countdown-bar-{{ section.id }}.snippetshub-countdown-bar--mothers_day .snippetshub-countdown-bar__button--secondary {
        background-color: #f779c1;
        color: #ffffff;
      }
      #snippetshub-countdown-bar-{{ section.id }}.snippetshub-countdown-bar--mothers_day .snippetshub-countdown-bar__timer {
        color: #ffffff;
      }
      #snippetshub-countdown-bar-{{ section.id }}.snippetshub-countdown-bar--mothers_day .snippetshub-countdown-bar__close {
        color: #ffffff;
      }

      #snippetshub-countdown-bar-{{ section.id }}.snippetshub-countdown-bar--fathers_day .snippetshub-countdown-bar__inner {
        background: linear-gradient(90deg,#e6f0ff,#4a90e2);
        background-image: url({{ 'snippetshub-countdown-bar-fathers_day.png' | asset_url }});
        background-size: cover;
        color: #031728;
      }
      #snippetshub-countdown-bar-{{ section.id }}.snippetshub-countdown-bar--fathers_day .snippetshub-countdown-bar__text {
        font-size: 16px;
        font-weight: 500;
        color: #031728;
      }
      #snippetshub-countdown-bar-{{ section.id }}.snippetshub-countdown-bar--fathers_day .snippetshub-countdown-bar__button--primary {
        {% comment %} background-color: #0573a8; {% endcomment %}
        background-color: rgba(0, 0, 0, 0);
        color: #ffffff;
      }
      #snippetshub-countdown-bar-{{ section.id }}.snippetshub-countdown-bar--fathers_day .snippetshub-countdown-bar__button--secondary {
        background-color: #4a90e2;
        color: #e6f0ff;
      }
      #snippetshub-countdown-bar-{{ section.id }}.snippetshub-countdown-bar--fathers_day .snippetshub-countdown-bar__timer {
