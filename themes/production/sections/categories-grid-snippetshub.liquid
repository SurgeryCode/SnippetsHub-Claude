{% comment %}
  Categories Grid Section
{% endcomment %}

<section class="section-py container">
  <div class="text-center">
    <h2 class="section-title-sm">{{ section.settings.title }}</h2>
  </div>
  
  <div class="categories-grid">
    {% for block in section.blocks %}
      <a href="{{ block.settings.link }}" class="category-card" {{ block.shopify_attributes }}>
        <span class="cat-icon">{{ block.settings.icon }}</span>
        <span class="cat-title">{{ block.settings.title }}</span>
      </a>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Categories Grid",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Browse Categories"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (Emoji)",
          "default": "🏠"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category Title",
          "default": "Hero Sections"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Categories Grid",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "icon": "🏠",
            "title": "Hero Sections"
          }
        },
        {
          "type": "category",
          "settings": {
            "icon": "📦",
            "title": "Product Pages"
          }
        },
        {
          "type": "category",
          "settings": {
            "icon": "🛒",
            "title": "Carts (Drawer)"
          }
        },
        {
          "type": "category",
          "settings": {
            "icon": "📢",
            "title": "Popups & Bars"
          }
        },
        {
          "type": "category",
          "settings": {
            "icon": "💳",
            "title": "Checkout"
          }
        },
        {
          "type": "category",
          "settings": {
            "icon": "✨",
            "title": "Bundles"
          }
        }
      ]
    }
  ]
}
{% endschema %}
