    },
    {
      "type": "text",
      "id": "name",
      "label": "Name",
      "default": "Piotr Nowak"
    },
    {
      "type": "text",
      "id": "role",
      "label": "Role Title",
      "default": "IT&D Senior Analyst, D2C Full Stack Developer"
    },
    {
      "type": "richtext",
      "id": "bio",
      "label": "Bio / Introduction",
