{% liquid
  assign queue_count = 0
  assign progress_count = 0
  assign done_count = 0

  for block in section.blocks
    case block.settings.status
      when 'queue'
        assign queue_count = queue_count | plus: 1
      when 'progress'
        assign progress_count = progress_count | plus: 1
      when 'done'
        assign done_count = done_count | plus: 1
    endcase
  endfor
%}

<section id="community-board-standard-{{ section.id }}" class="community-board-standard section-spacing">
  <div class="premium-request-container community-board-standard__container">
    <div class="ambient-glow glow-1"></div>
    <div class="ambient-glow glow-2"></div>

    <div class="glass-card community-board-standard__card">
      <header class="form-header text-center community-board-standard__header">
        <span class="badge badge-gradient">{{ section.settings.badge_text }}</span>
        <h1>{{ section.settings.title }}</h1>
        <p>{{ section.settings.subtitle }}</p>
      </header>

      <div class="community-board-standard__grid">
        <article class="community-board-standard__column">
          <h3 class="community-board-standard__title">{{ section.settings.form_title }}</h3>
          <p class="community-board-standard__description">{{ section.settings.form_description }}</p>

          {% form 'contact', class: 'premium-form community-board-standard__form' %}
            {% if form.posted_successfully? %}
              <p class="community-board-standard__notice" role="status">{{ section.settings.success_message }}</p>
            {% else %}
              {{ form.errors | default_errors }}
            {% endif %}

            <div class="input-group">
              <label for="CommunityName-{{ section.id }}">{{ section.settings.name_label }}</label>
              <input
                type="text"
                id="CommunityName-{{ section.id }}"
                name="contact[name]"
                placeholder="{{ section.settings.name_placeholder }}"
                value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
              >
            </div>

            <div class="input-group">
              <label for="CommunityEmail-{{ section.id }}">{{ section.settings.email_label }}</label>
              <input
                type="email"
                id="CommunityEmail-{{ section.id }}"
                name="contact[email]"
                placeholder="{{ section.settings.email_placeholder }}"
                autocorrect="off"
                autocapitalize="off"
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                required
              >
            </div>

            <div class="input-group full-width">
              <label for="CommunityType-{{ section.id }}">{{ section.settings.type_label }}</label>
              <select id="CommunityType-{{ section.id }}" name="contact[request_type]">
                <option value="Feature Request">{{ section.settings.option_feature }}</option>
                <option value="Bug Report">{{ section.settings.option_bug }}</option>
                <option value="UX Improvement">{{ section.settings.option_ux }}</option>
              </select>
              <div class="select-arrow">▼</div>
            </div>

            <div class="input-group full-width">
              <label for="CommunityMessage-{{ section.id }}">{{ section.settings.message_label }}</label>
              <textarea
                rows="5"
                id="CommunityMessage-{{ section.id }}"
                name="contact[body]"
                placeholder="{{ section.settings.message_placeholder }}"
                required
              >{% if form.body %}{{ form.body }}{% endif %}</textarea>
            </div>

            <button type="submit" class="btn btn-primary btn-glow">{{ section.settings.button_text }}</button>
          {% endform %}
        </article>

        <aside class="community-board-standard__column">
          <div class="community-board-standard__roadmap-header">
            <h3 class="community-board-standard__title">{{ section.settings.roadmap_title }}</h3>
            <div class="community-board-standard__stats" aria-label="{{ 'snippetshub.community.roadmap_stats_aria' | t }}">
              <span class="community-board-standard__stat status-queue">{{ queue_count }} {{ section.settings.label_queue }}</span>
              <span class="community-board-standard__stat status-progress">{{ progress_count }} {{ section.settings.label_progress }}</span>
              <span class="community-board-standard__stat status-done">{{ done_count }} {{ section.settings.label_done }}</span>
            </div>
          </div>

          <div class="community-board-standard__list">
            {% if section.blocks.size > 0 %}
              {% for block in section.blocks %}
                <article class="community-board-standard__item status-{{ block.settings.status }}" {{ block.shopify_attributes }}>
                  <div class="community-board-standard__item-header">
                    <h4 class="community-board-standard__item-title">{{ block.settings.task_title }}</h4>
                    {% case block.settings.status %}
                      {% when 'queue' %}
                        <span class="badge badge-utils">{{ section.settings.label_queue }}</span>
                      {% when 'progress' %}
                        <span class="badge badge-videocalls">{{ section.settings.label_progress }}</span>
                      {% when 'done' %}
                        <span class="badge badge-success">{{ section.settings.label_done }}</span>
                    {% endcase %}
                  </div>
                  <p class="community-board-standard__item-footer">
                    {{ section.settings.submitted_by_text }} {{ block.settings.submitter }}
                  </p>
                </article>
              {% endfor %}
            {% else %}
              <p class="community-board-standard__empty">{{ section.settings.empty_state_text }}</p>
            {% endif %}
          </div>
        </aside>
      </div>
    </div>
  </div>
</section>

