<script>
  // Variant Switching Logic
  const variantOptions = document.querySelectorAll('.variant-option');
  const mainPrice = document.querySelector('.current-price');
  const priceBlock = document.querySelector('.price-block');
  let originalPrice = priceBlock ? priceBlock.querySelector('.price-original') : null;
  let discountBadge = priceBlock ? priceBlock.querySelector('.discount-badge') : null;
  const variantInput = document.querySelector('input[name="id"]');
  const productGallery = document.querySelector('[data-product-gallery]');

  const updateDiscountUi = (comparePriceText, discountValue) => {
    if (!priceBlock || !mainPrice) return;

    const hasDiscount = comparePriceText && Number(discountValue) > 0;

    if (hasDiscount) {
      if (!originalPrice) {
        originalPrice = document.createElement('span');
        originalPrice.className = 'price-original';
        mainPrice.insertAdjacentElement('afterend', originalPrice);
      }
      originalPrice.textContent = comparePriceText;

      if (!discountBadge) {
        discountBadge = document.createElement('span');
        discountBadge.className = 'discount-badge';
        originalPrice.insertAdjacentElement('afterend', discountBadge);
      }
      discountBadge.textContent = `-${discountValue}%`;
      return;
    }

    if (discountBadge) {
      discountBadge.remove();
      discountBadge = null;
    }
    if (originalPrice) {
      originalPrice.remove();
      originalPrice = null;
    }
  };

  variantOptions.forEach((option) => {
    option.addEventListener('click', () => {
      // Update UI
      variantOptions.forEach((opt) => opt.classList.remove('active'));
      option.classList.add('active');

      // Update Form and Price
      const variantId = option.getAttribute('data-variant-id');
      const price = option.getAttribute('data-price');
      const comparePrice = option.getAttribute('data-compare-price');
      const discount = option.getAttribute('data-discount');
      const featuredMediaId = option.getAttribute('data-featured-media-id');

      if (variantInput) variantInput.value = variantId;
      if (mainPrice) mainPrice.textContent = price;
      updateDiscountUi(comparePrice, discount);
      if (featuredMediaId) productGallery?.activateMediaById?.(featuredMediaId);
    });
  });

  // Product quantity counter (+/-)
  document.querySelectorAll('[data-product-qty-control]').forEach((control) => {
    const input = control.querySelector('[data-product-qty-input]');
    const minus = control.querySelector('[data-product-qty-minus]');
    const plus = control.querySelector('[data-product-qty-plus]');

    if (!input || !minus || !plus) return;

    const normalizeQty = () => {
      const min = parseInt(input.getAttribute('min') || '1', 10);
      const value = parseInt(input.value, 10);
      const safeValue = Number.isNaN(value) || value < min ? min : value;
      input.value = safeValue;
      minus.disabled = safeValue <= min;
    };

    minus.addEventListener('click', () => {
      normalizeQty();
      input.value = Math.max(parseInt(input.getAttribute('min') || '1', 10), parseInt(input.value, 10) - 1);
      normalizeQty();
    });

    plus.addEventListener('click', () => {
      normalizeQty();
      input.value = parseInt(input.value, 10) + 1;
      normalizeQty();
    });

    input.addEventListener('input', normalizeQty);
    normalizeQty();
  });

  // FAQ accordion behavior (one open item per list)
  document.querySelectorAll('[data-pdp-tabs] .faq-list').forEach((faqList) => {
    const faqItems = Array.from(faqList.querySelectorAll('.faq-item'));
    faqItems.forEach((item) => {
      item.addEventListener('toggle', () => {
        if (!item.open) return;
        faqItems.forEach((otherItem) => {
          if (otherItem !== item) otherItem.open = false;
        });
      });
    });
  });

  // Tabs Logic (scoped, accessible)
  document.querySelectorAll('[data-pdp-tabs]').forEach((tabsRoot) => {
    const tabBtns = Array.from(tabsRoot.querySelectorAll('.tab-btn'));
    const tabContents = Array.from(tabsRoot.querySelectorAll('.tab-content'));
    if (!tabBtns.length || !tabContents.length) return;

    const activateTab = (tabId) => {
      tabBtns.forEach((btn) => {
        const isActive = btn.getAttribute('data-tab') === tabId;
        btn.classList.toggle('active', isActive);
        btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
        btn.setAttribute('tabindex', isActive ? '0' : '-1');
      });

      tabContents.forEach((content) => {
        const isActive = content.id === tabId;
        content.classList.toggle('active', isActive);
        if (isActive) {
          content.removeAttribute('hidden');
        } else {
          content.setAttribute('hidden', 'hidden');
        }
      });
    };

    tabBtns.forEach((btn, index) => {
      btn.addEventListener('click', () => activateTab(btn.getAttribute('data-tab')));
      btn.addEventListener('keydown', (event) => {
        let nextIndex = index;
        if (event.key === 'ArrowRight') nextIndex = (index + 1) % tabBtns.length;
        if (event.key === 'ArrowLeft') nextIndex = (index - 1 + tabBtns.length) % tabBtns.length;
        if (event.key === 'Home') nextIndex = 0;
        if (event.key === 'End') nextIndex = tabBtns.length - 1;
        if (nextIndex !== index) {
          event.preventDefault();
          const nextBtn = tabBtns[nextIndex];
          activateTab(nextBtn.getAttribute('data-tab'));
          nextBtn.focus();
        }
      });
    });
  });

  window.SnippetsHubProductGallery?.initAll?.();

  // Theme toggle (if needed)
  const themeToggle = document.querySelector('.theme-toggle');
  const htmlElement = document.documentElement;

  themeToggle?.addEventListener('click', () => {
    const currentTheme = htmlElement.getAttribute('data-theme');
    const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
    htmlElement.setAttribute('data-theme', newTheme);
    localStorage.setItem('theme', newTheme);
    themeToggle.textContent = newTheme === 'dark' ? '☀️' : '🌙';
  });

  const copiedLabel = {{ 'snippetshub.pdp_tabs.actions.copied' | t | json }};

  // Copy Code Logic (supports multiple code tabs)
  document.querySelectorAll('[data-copy]').forEach((copyBtn) => {
    copyBtn.addEventListener('click', () => {
      const targetId = copyBtn.getAttribute('data-copy');
      const codeSample = targetId ? document.getElementById(targetId) : null;
      if (!codeSample) return;

      navigator.clipboard.writeText(codeSample.innerText).then(() => {
        const originalText = copyBtn.textContent;
        copyBtn.textContent = copiedLabel;
        setTimeout(() => {
          copyBtn.textContent = originalText;
        }, 10000);
      });
    });
  });
</script>

