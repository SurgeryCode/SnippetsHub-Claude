{% comment %}
  SnippetsHub Premium Product Page
  Redesigned for "Glassmorphism" aesthetic.
{% endcomment %}

<section class="section-py container relative">
  <!-- Decorative Orbs (Optional if not in global layout) -->
  <div class="ambient-glow glow-3"></div>
  <div class="ambient-glow glow-4"></div>

  <div class="product-grid-layout" style="margin-top: 2rem;">
    <!-- Left: Gallery -->
    {% render 'snippetshub-product-gallery', product: product %}

    <!-- Right: Product Info (Sticky) -->
    <div class="product-info-sticky">
      <div class="glass-card p-8">
        {%- liquid
          assign all_collection_url = routes.all_products_collection_url
          assign current_collection = product.collections.first
          assign show_collection_crumb = false
          if current_collection and current_collection.url != blank and current_collection.url != all_collection_url
            assign show_collection_crumb = true
          endif
        -%}
        <nav class="breadcrumb mb-4" aria-label="{{ 'snippetshub.pdp_tabs.accessibility.breadcrumb' | t }}">
          <a href="{{ routes.root_url }}" class="text-muted hover-primary">
            {{- 'snippetshub.pdp_tabs.breadcrumb.home' | t -}}
          </a>
          <span class="text-muted">/</span>
          <a href="{{ all_collection_url }}" class="text-muted hover-primary">
            {{- 'snippetshub.pdp_tabs.breadcrumb.snippets' | t -}}
          </a>
          {% if show_collection_crumb %}
            <span class="text-muted">/</span>
            <a href="{{ current_collection.url }}" class="text-muted hover-primary">
              {{- current_collection.title -}}
            </a>
          {% endif %}
          <span class="text-muted">/</span>
          <span class="breadcrumb-current" aria-current="page" title="{{ product.title | escape }}">
            {{- product.title | truncate: 20 -}}
          </span>
        </nav>

        <h1 class="h2 mb-4">{{ product.title }}</h1>

        {%- liquid
          assign money_price = product.price | money
          assign money_compare = product.compare_at_price | money
          if settings.currency_code_enabled
            assign money_price = product.price | money_with_currency
            assign money_compare = product.compare_at_price | money_with_currency
          endif
        -%}

        <div class="price-block">
          <span class="current-price">{{ money_price }}</span>

          {% if product.compare_at_price > product.price %}
            <span class="price-original">{{ money_compare }}</span>
            {%- assign discount = product.compare_at_price
              | minus: product.price
              | times: 100
              | divided_by: product.compare_at_price
              | round
            -%}
            <span class="discount-badge">-{{ discount }}%</span>
          {% endif %}
        </div>

        <!-- Short Description -->
        <div class="short-desc mb-6">
          {{ product.metafields.descriptor.short_desc | default: product.description | strip_html | truncatewords: 30 }}
        </div>

        <!-- Live Demo Button -->
        {% if product.metafields.custom.demo_url != blank %}
          <a href="{{ product.metafields.custom.demo_url }}" target="_blank" class="btn btn-outline btn-demo">
            👁 {{ 'snippetshub.pdp_tabs.actions.view_live_demo' | t }}
          </a>
        {% endif %}

        {% form 'product', product, class: 'purchase-actions', data-expert-install-form: '' %}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

          {% if product.variants.size > 1 %}
            <div class="variant-selector">
              <label class="variant-label">{{ 'snippetshub.pdp_tabs.product.license_type' | t }}</label>
              <div class="variant-options">
                {% for variant in product.variants %}
                  {%- liquid
                    assign variant_price = variant.price | money
                    assign variant_compare = ''
                    assign variant_discount = 0
                    if settings.currency_code_enabled
                      assign variant_price = variant.price | money_with_currency
                    endif
                    if variant.compare_at_price > variant.price
                      assign variant_compare = variant.compare_at_price | money
                      if settings.currency_code_enabled
                        assign variant_compare = variant.compare_at_price | money_with_currency
                      endif
                      assign variant_discount = variant.compare_at_price | minus: variant.price | times: 100 | divided_by: variant.compare_at_price | round
                    endif
                  -%}
                  <button
                    type="button"
                    class="variant-option {% if variant.id == product.selected_or_first_available_variant.id %}active{% endif %}"
                    data-variant-id="{{ variant.id }}"
                    data-price="{{ variant_price | strip_html | escape }}"
                    data-compare-price="{{ variant_compare | strip_html | escape }}"
                    data-discount="{{ variant_discount }}"
                    data-featured-media-id="{{ variant.featured_media.id }}"
                  >
                    {{ variant.title }}
                  </button>
                {% endfor %}
              </div>
            </div>
          {% endif %}
          <div class="product-qty-control mt-4 mb-2" data-product-qty-control>
            <label class="variant-label" for="main-product-qty-{{ product.id }}">
              {{- 'products.product.quantity.label' | t -}}
            </label>
            <div class="qty-selector product-qty-selector sticky-product-qty">
              <button
                type="button"
                class="product-qty-btn sticky-product-qty__btn"
                data-product-qty-minus
                aria-label="{{ 'products.product.quantity.decrease' | t }}"
              >
                -
              </button>
              <input
                id="main-product-qty-{{ product.id }}"
                type="number"
                name="quantity"
                value="1"
                min="1"
                inputmode="numeric"
                class="upsell-qty-input product-qty-input sticky-product-qty__input"
                data-product-qty-input
              >
              <button
                type="button"
                class="product-qty-btn sticky-product-qty__btn"
                data-product-qty-plus
                aria-label="{{ 'products.product.quantity.increase' | t }}"
              >
                +
              </button>
            </div>
          </div>

          {% render 'expert-install-upsell',
            title_key: 'snippetshub.expert_install.add_expert_install',
            subtitle_key: 'snippetshub.expert_install.delivery_time',
            qty_label_key: 'snippetshub.expert_install.need_more_hours',
            show_qty: true,
            show_info: false,
            hours: product.metafields.custom.installation_hours,
            hide_expert_install: product.metafields.custom.hide_expert_install
          %}

          <button type="submit" name="add" class="btn btn-primary btn-lg btn-glow w-full mt-4" aria-live="polite">
            <span class="snh-add-to-cart-label">{{ 'products.product.add_to_cart' | t }}</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="ml-2"
            >
              <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
            </svg>
            {%- render 'loading-spinner' -%}
          </button>

          {{ form | payment_terms }}
        {% endform %}

        <div class="trust-badges justify-center">
          <div class="flex flex-col items-center gap-2">
            <span>⚡ {{ 'snippetshub.pdp_tabs.trust.instant_download' | t }}</span>
          </div>
          <div class="flex flex-col items-center gap-2">
            <span>🔒 {{ 'snippetshub.pdp_tabs.trust.secure_payment' | t }}</span>
          </div>
          <div class="flex flex-col items-center gap-2">
            <span>✅ {{ 'snippetshub.pdp_tabs.trust.verified_code' | t }}</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{%- liquid
  assign has_code_tab = true

  assign has_specs_tab = true

  assign has_install_tab = true

  assign has_faq_tab = true

  assign has_reviews_tab = false
  if product.metafields.reviews.rating.value != blank or product.metafields.reviews.rating_count != blank
    assign has_reviews_tab = true
  endif

  assign rating_value = product.metafields.reviews.rating.value.rating | default: product.metafields.reviews.rating.value | default: 0
  assign rating_count = product.metafields.reviews.rating_count | default: 0
-%}

<section class="container relative pdp-tabs" data-pdp-tabs>
  <header class="pdp-tabs__header">
    <div class="pdp-tabs__eyebrow">{{ 'snippetshub.pdp_tabs.header.eyebrow' | t }}</div>
    <h2 class="pdp-tabs__title">{{ 'snippetshub.pdp_tabs.header.title' | t }}</h2>
    <p class="pdp-tabs__subtitle">{{ 'snippetshub.pdp_tabs.header.subtitle' | t }}</p>
  </header>

  <div class="pdp-tabs__shell">
    <nav
      class="tabs-nav tabs-nav--pdp"
      role="tablist"
      aria-label="{{ 'snippetshub.pdp_tabs.accessibility.tabs_nav' | t }}"
    >
      <button
        class="tab-btn active"
        data-tab="description-{{ section.id }}"
        role="tab"
        aria-controls="description-{{ section.id }}"
        aria-selected="true"
      >
        <span class="tab-text">{{ 'snippetshub.pdp_tabs.tabs.description' | t }}</span>
      </button>
      {% if has_specs_tab %}
        <button
          class="tab-btn"
          data-tab="specs-{{ section.id }}"
          role="tab"
          aria-controls="specs-{{ section.id }}"
          aria-selected="false"
        >
          <span class="tab-text">{{ 'snippetshub.pdp_tabs.tabs.specifications' | t }}</span>
        </button>
      {% endif %}
      {% if has_code_tab %}
        <button
          class="tab-btn"
          data-tab="code-{{ section.id }}"
          role="tab"
          aria-controls="code-{{ section.id }}"
          aria-selected="false"
        >
          <span class="tab-text">{{ 'snippetshub.pdp_tabs.tabs.code_preview' | t }}</span>
        </button>
      {% endif %}
      {% if has_install_tab %}
        <button
          class="tab-btn"
          data-tab="installation-{{ section.id }}"
          role="tab"
          aria-controls="installation-{{ section.id }}"
          aria-selected="false"
        >
          <span class="tab-text">{{ 'snippetshub.pdp_tabs.tabs.installation' | t }}</span>
        </button>
      {% endif %}
      {% if has_faq_tab %}
        <button
          class="tab-btn"
          data-tab="faq-{{ section.id }}"
          role="tab"
          aria-controls="faq-{{ section.id }}"
          aria-selected="false"
        >
          <span class="tab-text">{{ 'snippetshub.pdp_tabs.tabs.faq' | t }}</span>
        </button>
      {% endif %}
      {% if has_reviews_tab %}
        <button
          class="tab-btn"
          data-tab="reviews-{{ section.id }}"
          role="tab"
          aria-controls="reviews-{{ section.id }}"
          aria-selected="false"
        >
          <span class="tab-text">{{ 'snippetshub.pdp_tabs.tabs.reviews' | t }}</span>
          <span class="tab-count">{{ rating_count }}</span>
        </button>
      {% endif %}
    </nav>

    <div class="pdp-tabs__panels">
      <div class="tab-content rte active" id="description-{{ section.id }}" role="tabpanel">
        <div class="description">
          {{ product.description }}
        </div>
      </div>

      {% if has_specs_tab %}
        <div class="tab-content rte" id="specs-{{ section.id }}" role="tabpanel" hidden>
          <div class="specs-static">
            <h3 class="specs-heading">{{ 'snippetshub.pdp_tabs.specs.basic_title' | t }}</h3>
            <div class="specs-table-wrap">
              <table class="specs-table">
                <tbody>
                  <tr>
                    <th scope="row">{{ 'snippetshub.pdp_tabs.specs.compatibility_label' | t }}</th>
                    <td>{{ 'snippetshub.pdp_tabs.specs.compatibility_value' | t }}</td>
                  </tr>
                  <tr>
                    <th scope="row">{{ 'snippetshub.pdp_tabs.specs.tested_themes_label' | t }}</th>
                    <td>{{ 'snippetshub.pdp_tabs.specs.tested_themes_value' | t }}</td>
                  </tr>
                  <tr>
                    <th scope="row">{{ 'snippetshub.pdp_tabs.specs.implementation_label' | t }}</th>
                    <td>{{ 'snippetshub.pdp_tabs.specs.implementation_value' | t }}</td>
                  </tr>
                  <tr>
                    <th scope="row">{{ 'snippetshub.pdp_tabs.specs.performance_label' | t }}</th>
                    <td>{{ 'snippetshub.pdp_tabs.specs.performance_value' | t }}</td>
                  </tr>
                  <tr>
                    <th scope="row">{{ 'snippetshub.pdp_tabs.specs.seo_accessibility_label' | t }}</th>
                    <td>{{ 'snippetshub.pdp_tabs.specs.seo_accessibility_value' | t }}</td>
                  </tr>
                  <tr>
                    <th scope="row">{{ 'snippetshub.pdp_tabs.specs.support_updates_label' | t }}</th>
                    <td>{{ 'snippetshub.pdp_tabs.specs.support_updates_value' | t }}</td>
                  </tr>
                </tbody>
              </table>
            </div>
            <p class="specs-note">
              {{ 'snippetshub.pdp_tabs.specs.note' | t }}
            </p>
          </div>

          {% assign specs_metafield = product.metafields.custom.specifications %}
          {% if specs_metafield != blank %}
            <div class="specs-dynamic">
              <h4 class="specs-subheading">{{ 'snippetshub.pdp_tabs.specs.additional_title' | t }}</h4>
              {% if specs_metafield.type == 'rich_text_field' %}
                {{ specs_metafield | metafield_tag }}
              {% elsif specs_metafield.type == 'multi_line_text_field' %}
                {{ specs_metafield.value | escape | newline_to_br }}
              {% else %}
                {{ specs_metafield.value | default: specs_metafield | escape }}
              {% endif %}
            </div>
          {% endif %}
        </div>
      {% endif %}

      {% if has_code_tab %}
        <div class="tab-content rte" id="code-{{ section.id }}" role="tabpanel" hidden>
          <div class="specs-static">
            <h3 class="specs-heading">{{ 'snippetshub.pdp_tabs.code.basic_title' | t }}</h3>
            <p class="specs-note">
              {{ 'snippetshub.pdp_tabs.code.basic_note' | t }}
            </p>
            <ol>
              <li>{{ 'snippetshub.pdp_tabs.code.safe_step_1' | t }}</li>
              <li>{{ 'snippetshub.pdp_tabs.code.safe_step_2' | t }}</li>
              <li>{{ 'snippetshub.pdp_tabs.code.safe_step_3' | t }}</li>
              <li>{{ 'snippetshub.pdp_tabs.code.safe_step_4' | t }}</li>
              <li>{{ 'snippetshub.pdp_tabs.code.safe_step_5' | t }}</li>
            </ol>
            <p class="specs-note">
              {{ 'snippetshub.pdp_tabs.code.settings_recommendation' | t }}
            </p>
          </div>
          <div class="code-block">
            <div class="code-header">
              <div class="code-header__left">
                <span class="code-dots" aria-hidden="true"><i></i><i></i><i></i></span>
                <span class="code-title">{{ 'snippetshub.pdp_tabs.code.base_file_name' | t }}</span>
              </div>
              <div class="code-header__right">
                <span class="code-language" aria-label="{{ 'snippetshub.pdp_tabs.accessibility.code_language' | t }}">
                  {{- 'snippetshub.pdp_tabs.code.language_label' | t -}}
                </span>
                <button
                  class="copy-btn"
                  data-copy="code-sample-base-{{ section.id }}"
                  aria-label="{{ 'snippetshub.pdp_tabs.accessibility.copy_code' | t }}"
                >
                  {{ 'snippetshub.pdp_tabs.actions.copy_code' | t }}
                </button>
              </div>
            </div>
            <pre
              class="code-content"
              tabindex="0"
              aria-label="{{ 'snippetshub.pdp_tabs.accessibility.code_preview' | t }}"
              id="code-sample-base-{{ section.id }}"
            >
              <code>
                {% raw %}
                  <section>
                    {% comment %} 1) Duplicate theme before editing as a safe backup {% endcomment %}
                    {% comment %} 2) Put snippet file in snippets/your-snippet-handle.liquid {% endcomment %}
                    {% comment %} 3) If needed, create section file in sections/ and expose settings in {% schema %} {% endcomment %}

                    <section class="snippet-wrapper">
                      {% if section.settings.enable_snippet %}
                        {% render 'your-snippet-handle',
                          heading: section.settings.heading,
                          color_scheme: section.settings.color_scheme
                        %}
                      {% endif %}
                    </section>

                    {% comment %} Example fallback when section settings are not available in this context {% endcomment %}
                    {% if product.available %}
                      {% render 'your-snippet-handle', mode: 'product', product: product %}
                    {% else %}
                      {% render 'your-snippet-handle', mode: 'generic' %}
                    {% endif %}

                    {% comment %} Prefer configuring behavior from section settings first, then add custom Liquid conditions {% endcomment %}

                      {% comment %} 4) Insert render in the target template/section and test on duplicate theme {% endcomment %}
                    {% comment %} 5) Check desktop/mobile, cart flow, and publish after QA {% endcomment %}
                  </section>
                {% endraw %}
              </code>
            </pre>
          </div>
          <div class="specs-static">
            <p class="specs-note">
              {{ 'snippetshub.pdp_tabs.code.implementation_disclaimer_html' | t }}
            </p>
          </div>
          {% if product.metafields.custom.code_preview != blank %}
            <div class="specs-dynamic">
              <h4 class="specs-subheading">{{ 'snippetshub.pdp_tabs.code.additional_title' | t }}</h4>
              <div class="code-block">
                <div class="code-header">
                  <div class="code-header__left">
                    <span class="code-dots" aria-hidden="true"><i></i><i></i><i></i></span>
                    <span class="code-title">{{ 'snippetshub.pdp_tabs.code.custom_file_name' | t }}</span>
                  </div>
                  <div class="code-header__right">
                    <span
                      class="code-language"
                      aria-label="{{ 'snippetshub.pdp_tabs.accessibility.code_language' | t }}"
                    >
                      {{- 'snippetshub.pdp_tabs.code.language_label' | t -}}
                    </span>
                    <button
                      class="copy-btn"
                      data-copy="code-sample-{{ section.id }}"
                      aria-label="{{ 'snippetshub.pdp_tabs.accessibility.copy_code' | t }}"
                    >
                      {{ 'snippetshub.pdp_tabs.actions.copy_code' | t }}
                    </button>
                  </div>
                </div>
                <pre
                  class="code-content"
                  tabindex="0"
                  aria-label="{{ 'snippetshub.pdp_tabs.accessibility.additional_code_preview' | t }}"
                  id="code-sample-{{ section.id }}"><code>{{ product.metafields.custom.code_preview.value | default: product.metafields.custom.code_preview | escape }}</code></pre>
              </div>
            </div>
          {% endif %}
        </div>
      {% endif %}

      {% if has_install_tab %}
        <div class="tab-content rte" id="installation-{{ section.id }}" role="tabpanel" hidden>
          <div class="specs-static">
            <h3 class="specs-heading">{{ 'snippetshub.pdp_tabs.installation.basic_title' | t }}</h3>
            <ul>
              <li>{{ 'snippetshub.pdp_tabs.installation.step_1' | t }}</li>
              <li>{{ 'snippetshub.pdp_tabs.installation.step_2' | t }}</li>
              <li>{{ 'snippetshub.pdp_tabs.installation.step_3' | t }}</li>
            </ul>
            <p class="specs-note">
              {{ 'snippetshub.pdp_tabs.installation.estimated_time' | t }}
              {{ product.metafields.custom.installation_hours }}
              {{ 'snippetshub.pdp_tabs.installation.hours_suffix' | t }}
            </p>
          </div>

          {% if product.metafields.custom.installation_guide != blank
            or product.metafields.custom.installation_hours != blank
            or product.metafields.custom.demo_url != blank
          %}
            <div class="specs-dynamic">
              <h4 class="specs-subheading">{{ 'snippetshub.pdp_tabs.installation.additional_title' | t }}</h4>
              {% if product.metafields.custom.installation_guide != blank %}
                {{ product.metafields.custom.installation_guide | metafield_tag }}
              {% endif %}
              {% if product.metafields.custom.installation_hours != blank %}
                <p>
                  <strong>{{ 'snippetshub.pdp_tabs.installation.estimated_setup_time' | t }}</strong>
                  {{ product.metafields.custom.installation_hours }}
                  {{ 'snippetshub.pdp_tabs.installation.hours_suffix' | t }}
                </p>
              {% endif %}
              {% if product.metafields.custom.demo_url != blank %}
                <p>
                  <a
                    href="{{ product.metafields.custom.demo_url }}"
                    target="_blank"
                    rel="noopener"
                    class="btn btn-outline"
                  >
                    {{ 'snippetshub.pdp_tabs.actions.view_live_demo' | t }}
                  </a>
                </p>
              {% endif %}
            </div>
          {% endif %}
        </div>
      {% endif %}

      {% if has_faq_tab %}
        <div class="tab-content rte" id="faq-{{ section.id }}" role="tabpanel" hidden>
          <div class="specs-static">
            <h3 class="specs-heading">{{ 'snippetshub.pdp_tabs.faq.basic_title' | t }}</h3>
            <div class="faq-list">
              <details class="faq-item">
                <summary>
                  <span class="faq-question">{{ 'snippetshub.pdp_tabs.faq.q1' | t }}</span>
                  <span class="faq-icon" aria-hidden="true"></span>
                </summary>
                <div class="faq-answer">
                  <p>{{ 'snippetshub.pdp_tabs.faq.a1' | t }}</p>
                </div>
              </details>
              <details class="faq-item">
                <summary>
                  <span class="faq-question">{{ 'snippetshub.pdp_tabs.faq.q2' | t }}</span>
                  <span class="faq-icon" aria-hidden="true"></span>
                </summary>
                <div class="faq-answer">
                  <p>{{ 'snippetshub.pdp_tabs.faq.a2' | t }}</p>
                </div>
              </details>
            </div>
          </div>

          {% assign faq_metafield = product.metafields.custom.faq_list %}
          {% if faq_metafield != blank %}
            <div class="specs-dynamic">
              <h4 class="specs-subheading">{{ 'snippetshub.pdp_tabs.faq.additional_title' | t }}</h4>
              {% if faq_metafield.type == 'list.metaobject_reference' %}
                <div class="faq-list">
                  {% for faq_item in faq_metafield.value %}
                    <details class="faq-item">
                      <summary>
                        <span class="faq-question">
                          {% if faq_item.question.value != blank %}
                            {{ faq_item.question.value }}
                          {% else %}
                            {{ 'snippetshub.pdp_tabs.faq.question_fallback' | t }}
                          {% endif %}
                        </span>
                        <span class="faq-icon" aria-hidden="true"></span>
                      </summary>
                      <div class="faq-answer">
                        {% if faq_item.answer.type == 'rich_text_field' %}
                          {{ faq_item.answer | metafield_tag }}
                        {% else %}
                          {{ faq_item.answer.value | default: '' | escape | newline_to_br }}
                        {% endif %}
                      </div>
                    </details>
                  {% endfor %}
                </div>
              {% elsif faq_metafield.type == 'metaobject_reference' and faq_metafield.value != blank %}
                <div class="faq-list">
                  <details class="faq-item">
                    <summary>
                      <span class="faq-question">
                        {% if faq_metafield.value.question.value != blank %}
                          {{ faq_metafield.value.question.value }}
                        {% else %}
                          {{ 'snippetshub.pdp_tabs.faq.question_fallback' | t }}
                        {% endif %}
                      </span>
                      <span class="faq-icon" aria-hidden="true"></span>
                    </summary>
                    <div class="faq-answer">
                      {% if faq_metafield.value.answer.type == 'rich_text_field' %}
                        {{ faq_metafield.value.answer | metafield_tag }}
                      {% else %}
                        {{ faq_metafield.value.answer.value | default: '' | escape | newline_to_br }}
                      {% endif %}
                    </div>
                  </details>
                </div>
              {% else %}
                {{ faq_metafield.value | default: '' | escape | newline_to_br }}
              {% endif %}
            </div>
          {% endif %}
        </div>
      {% endif %}

      {% if has_reviews_tab %}
        <div class="tab-content rte" id="reviews-{{ section.id }}" role="tabpanel" hidden>
          <div class="reviews-section">
            <div class="review-summary">
              <div class="review-score">
                <div class="review-score-number">{{ rating_value | round: 1 }}</div>
                <div class="review-score-stars" aria-hidden="true">★★★★★</div>
                <div class="review-score-count">
                  {{ 'snippetshub.pdp_tabs.reviews.based_on_count' | t: count: rating_count }}
                </div>
              </div>
            </div>
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</section>

