      ]
    }
  ]
}
{% endschema %}

{{ 'section-main-about-developer.css.liquid' | asset_url | stylesheet_tag }}

<div class="dev-landing">
  <div class="dev-grid">
    
    <!-- Sidebar: Profile Card -->
    <aside class="profile-sidebar">
      <div class="profile-card">
        <div class="profile-cover" style="
          {% if section.settings.cover_image != blank %}
            background-image: url('{{ section.settings.cover_image | image_url: width: 800 }}');
          {% else %}
             background-image: url('{{ 'Background_LinkedIn.jpeg' | asset_url }}');
          {% endif %}
        "></div>
        
        <div class="profile-avatar-wrap">
           {% if section.settings.profile_image != blank %}
            {{ section.settings.profile_image | image_url: width: 400 | image_tag: class: 'profile-avatar', loading: 'eager', alt: section.settings.name }}
          {% else %}
             <img src="{{ 'My_profile_image_LinkedIn.jpeg' | asset_url }}" alt="{{ section.settings.name }}" class="profile-avatar">
          {% endif %}
        </div>
        
        <div class="profile-info">
          <h1 class="profile-name">{{ section.settings.name }}</h1>
          <span class="profile-role">{{ section.settings.role }}</span>
          
          {% if section.settings.cta_text != blank %}
            <a href="{{ section.settings.cta_url | default: '/pages/contact' }}" class="profile-btn">
              {{ section.settings.cta_text }}
            </a>
          {% endif %}
        </div>
      </div>
    </aside>
    
    <!-- Main Content -->
    <div class="profile-content">
      
      <!-- Bio Block -->
      <section class="content-block">
        <div class="block-title">{{ 'snippetshub.about_developer.block_titles.about_me' | t }}</div>
        <div class="dev-bio">
           {{ section.settings.bio }}
        </div>
      </section>
      
      <!-- Skills Block -->
      <section class="content-block">
        <div class="block-title">{{ 'snippetshub.about_developer.block_titles.skills_technologies' | t }}</div>
        <div class="skills-grid">
          {% for block in section.blocks %}
            {% if block.type == 'skill' %}
              <div class="skill-pill">
                <span class="skill-marker" style="background-color: {{ block.settings.color }};"></span>
                {{ block.settings.title }}
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </section>
      
      <!-- Experience Block -->
      <section class="content-block">
         <div class="block-title">{{ 'snippetshub.about_developer.block_titles.experience' | t }}</div>
         <div class="timeline-minimal">
            {% for block in section.blocks %}
              {% if block.type == 'experience' %}
                <div class="timeline-entry">
                  <div class="timeline-dot-minimal"></div>
                  <div class="entry-header">
                    <div class="entry-role">{{ block.settings.role }}</div>
                    <span class="entry-date">{{ block.settings.date }}</span>
                  </div>
                  <div class="entry-company">{{ block.settings.company }}</div>
                  <div class="entry-desc">
                    {{ block.settings.description }}
                  </div>
                </div>
              {% endif %}
            {% endfor %}
         </div>
      </section>

    </div>
  </div>
</div>
