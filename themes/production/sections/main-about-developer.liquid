          "type": "text",
          "id": "role",
          "label": "Role",
          "default": "Shopify Developer"
        },
        {
          "type": "text",
          "id": "company",
          "label": "Company",
          "default": "Company Name"
        },
        {
          "type": "text",
          "id": "date",
          "label": "Date Range",
          "default": "2020 - Present"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Developer Landing Page",
