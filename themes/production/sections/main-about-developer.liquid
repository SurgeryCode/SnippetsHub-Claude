    },
    {
      "type": "header",
      "content": "Section Colors"
    },
    {
        "type": "color",
        "id": "page_bg",
        "label": "Page Background",
        "default": "#f8f9fa"
    },
    {
        "type": "checkbox",
        "id": "use_glassmorphism",
        "label": "Use Glassmorphism Effect",
        "default": true
    }
  ],
  "blocks": [
    {
      "type": "skill",
