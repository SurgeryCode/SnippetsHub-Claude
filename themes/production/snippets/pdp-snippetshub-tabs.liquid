{% comment %}
  PDP Tabs (SnippetsHub)
{% endcomment %}

{%- assign include_review_card = include_review_card | default: true -%}

<section class="tabs">
  <nav class="tabs-nav" role="tablist">
    <button class="tab-btn active" data-tab="description" role="tab" aria-selected="true">{{ 'snippetshub.pdp_tabs.tabs.description' | t }}</button>
    <button class="tab-btn" data-tab="code" role="tab" aria-selected="false">{{ 'snippetshub.pdp_tabs.tabs.code_sample' | t }}</button>
    <button class="tab-btn" data-tab="specs" role="tab" aria-selected="false">{{ 'snippetshub.pdp_tabs.tabs.specifications' | t }}</button>
    <button class="tab-btn" data-tab="reviews" role="tab" aria-selected="false">{{ 'snippetshub.pdp_tabs.tabs.reviews_with_count' | t: count: 247 }}</button>
  </nav>

  <div class="tab-content active" id="description" role="tabpanel">
    <div class="description">
      {{ product.description }}
    </div>
  </div>

  <div class="tab-content" id="code" role="tabpanel">
    <div class="code-block">
      <div class="code-header">
        <span class="code-title">{{ 'snippetshub.pdp_tabs.code.preview_file_name' | t }}</span>
        <button class="copy-btn" data-copy="code-sample">{{ 'snippetshub.pdp_tabs.actions.copy_code' | t }}</button>
      </div>
      <pre class="code-content" id="code-sample"><code>
{%- if product.metafields.custom.code_preview -%}
{{ product.metafields.custom.code_preview | escape }}
{%- else -%}
// {{ 'snippetshub.pdp_tabs.code.no_preview_comment' | t }}
{%- endif -%}
                  </code></pre>
    </div>
    <p style="margin-top: 1.5rem; color: var(--text-muted); font-size: 0.875rem;">
      {{ 'snippetshub.pdp_tabs.code.preview_note' | t }}
    </p>
  </div>

  <div class="tab-content" id="specs" role="tabpanel">
    <table class="specs-table">
      <tbody>
        <tr>
          <td>{{ 'snippetshub.pdp_tabs.specs.platform' | t }}</td>
          <td>{{ 'snippetshub.pdp_tabs.specs.platform_value' | t }}</td>
        </tr>
        <tr>
          <td>{{ 'snippetshub.pdp_tabs.specs.format' | t }}</td>
          <td>{{ 'snippetshub.pdp_tabs.specs.format_value' | t }}</td>
        </tr>
        <tr>
          <td>{{ 'snippetshub.pdp_tabs.specs.support' | t }}</td>
          <td>{{ 'snippetshub.pdp_tabs.specs.support_value' | t }}</td>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="tab-content" id="reviews" role="tabpanel">
    <div class="reviews-section">
      <div class="review-summary">
        <div class="review-score">
          <div class="review-score-number">4.9</div>
          <div class="review-score-stars">★★★★★</div>
          <div class="review-score-count">{{ 'snippetshub.pdp_tabs.reviews.based_on_count' | t: count: 247 }}</div>
        </div>
        <div class="review-bars">
          <div class="review-bar">
            <span class="review-bar-label">{{ 'snippetshub.pdp_tabs.reviews.stars_5' | t }}</span>
            <div class="review-bar-track">
              <div class="review-bar-fill" style="width: 89%"></div>
            </div>
            <span class="review-bar-count">220</span>
          </div>
          <div class="review-bar">
            <span class="review-bar-label">{{ 'snippetshub.pdp_tabs.reviews.stars_4' | t }}</span>
            <div class="review-bar-track">
              <div class="review-bar-fill" style="width: 8%"></div>
            </div>
            <span class="review-bar-count">19</span>
          </div>
        </div>
      </div>

      {%- if include_review_card -%}
        <div class="review-card">
          <div class="review-header">
            <div class="review-author">
              <div class="review-avatar">SM</div>
              <div class="review-author-info">
                <h4>{{ 'snippetshub.pdp_tabs.reviews.sample_author' | t }}</h4>
                <span class="review-date">{{ 'snippetshub.pdp_tabs.reviews.verified_days_ago' | t: days: 5 }}</span>
              </div>
            </div>
            <div class="review-stars">★★★★★</div>
          </div>
          <div class="review-verified">{{ 'snippetshub.pdp_tabs.reviews.verified_purchase' | t }}</div>
          <p class="review-text">
            {{ 'snippetshub.pdp_tabs.reviews.sample_text' | t }}
          </p>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>
