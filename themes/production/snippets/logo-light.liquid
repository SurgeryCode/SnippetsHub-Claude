<svg
  height="70"
  viewBox="0 0 600 200"
  xmlns="http://www.w3.org/2000/svg"
  class="{{ class }}"
>
  <style>
    /* COLOR FILL */
    @-webkit-keyframes colorFill {
      from { fill: #cbd5e1; }
      to { fill: var(--final-color); }
    }
    @keyframes colorFill {
      from { fill: #cbd5e1; }
      to { fill: var(--final-color); }
    }

    /* SUBTLE PULSE */
    @-webkit-keyframes subtlePulse {
      0%, 10%, 100% {
        -webkit-filter: brightness(1);
                filter: brightness(1);
      }
      5% {
        -webkit-filter: brightness(1.3);
                filter: brightness(1.3);
      }
    }
    @keyframes subtlePulse {
      0%, 10%, 100% {
        -webkit-filter: brightness(1);
                filter: brightness(1);
      }
      5% {
        -webkit-filter: brightness(1.3);
                filter: brightness(1.3);
      }
    }

    /* FADE IN */
    @-webkit-keyframes fadeIn {
      to { opacity: 1; }
    }
    @keyframes fadeIn {
      to { opacity: 1; }
    }

    .logo-text {
      font-family: 'Inter', sans-serif;
      font-weight: 300;
    }

    .logo-bold {
      font-weight: 600;
    }

    .subtext {
      font-family: 'Inter', sans-serif;
      font-size: 18px;
      fill: #64748b;
      opacity: 0;
      -webkit-animation: fadeIn 0.5s ease forwards 1.2s;
              animation: fadeIn 0.5s ease forwards 1.2s;
    }

    .block {
      fill: #cbd5e1;
      will-change: filter;
      -webkit-animation:
        colorFill 1s ease forwards,
        subtlePulse 10s ease-in-out infinite;
              animation:
        colorFill 1s ease forwards,
        subtlePulse 10s ease-in-out infinite;
    }

    .p-1 { --final-color: #8b5cf6; -webkit-animation-delay: 0.1s, 10s; animation-delay: 0.1s, 10s; }
    .b-1 { --final-color: #1e40af; -webkit-animation-delay: 0.3s, 10.2s; animation-delay: 0.3s, 10.2s; }
    .c-1 { --final-color: #06b6d4; -webkit-animation-delay: 0.5s, 10.4s; animation-delay: 0.5s, 10.4s; }
    .b-2 { --final-color: #3b82f6; -webkit-animation-delay: 0.9s, 10.6s; animation-delay: 0.9s, 10.6s; }
    .p-2 { --final-color: #a78bfa; -webkit-animation-delay: 0.7s, 10.8s; animation-delay: 0.7s, 10.8s; }
    .c-2 { --final-color: #22d3ee; -webkit-animation-delay: 1.1s, 11s; animation-delay: 1.1s, 11s; }

    .text-anim {
      fill: #cbd5e1;
      -webkit-animation: colorFill 1s ease forwards;
              animation: colorFill 1s ease forwards;
    }

    .sh-text {
      --final-color: #0f172a;
      -webkit-animation-delay: 0s;
              animation-delay: 0s;
    }
  </style>

  <text x="40" y="80" font-size="60" class="logo-text sh-text text-anim">
    Snippets<tspan class="logo-bold">Hub</tspan>
  </text>

  <text x="40" y="115" class="subtext">
    Solutions for your business
  </text>

  <rect x="400" y="45" width="80" height="20" rx="4" class="block p-1" />
  <rect x="490" y="45" width="70" height="20" rx="4" class="block b-1" />

  <rect x="400" y="75" width="160" height="20" rx="4" class="block c-1" />

  <rect x="400" y="105" width="40" height="20" rx="4" class="block b-2" />
  <rect x="450" y="105" width="60" height="20" rx="4" class="block p-2" />
  <rect x="520" y="105" width="40" height="20" rx="4" class="block c-2" />
</svg>
