{% comment %}
  PDP Breadcrumb (SnippetsHub)
  Params:
  - include_collection: boolean (optional)
{% endcomment %}

<nav class="breadcrumb" aria-label="{{ 'snippetshub.navigation.breadcrumb' | t }}">
  <a href="{{ routes.root_url }}">{{ 'snippetshub.navigation.home' | t }}</a>
  <span class="breadcrumb-separator">/</span>
  <a href="{{ routes.all_products_collection_url }}">{{ 'snippetshub.navigation.snippets' | t }}</a>
  {%- if include_collection and product.collections.first -%}
    <span class="breadcrumb-separator">/</span>
    <a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a>
  {%- endif -%}
  <span class="breadcrumb-separator">/</span>
  <span>{{ product.title }}</span>
</nav>
