}
.facet-filters__label {
    font-size: 0.95rem !important;
    font-weight: 600 !important;
    color: var(--text-muted) !important;
    margin-right: 1rem !important;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.facet-filters__sort {
